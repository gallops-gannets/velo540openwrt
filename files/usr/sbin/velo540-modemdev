#!/bin/sh
# Print, or with -u apply, the sysfs path of the cellular modem.
#
# network.wwan.device pins the modem by sysfs path, and that path changes
# whenever it re-enumerates on a different bus: usb1/1-1 at USB 2, usb3/3-1 at
# SuperSpeed.  Moving the modem to another socket, or a re-plug that happens to
# train at the other speed, otherwise leaves netifd unable to find it at all
# ("couldn't find modem") and the cellular path silently stays down.
VID=${VID:-2c7c}   # Quectel

for d in /sys/bus/usb/devices/[0-9]*-[0-9]*; do
	[ "$(cat "$d/idVendor" 2>/dev/null)" = "$VID" ] || continue
	P=$(readlink -f "$d")
	break
done
[ -n "$P" ] || { echo "no modem with vendor $VID" >&2; exit 1; }

[ "$1" = "-u" ] || { echo "$P"; exit 0; }

# Refuse USB3 link power management on whichever SuperSpeed port the modem is
# actually on.  The static ss_lpm_off in velo540-switch names a fixed port, and
# bus numbers move when a controller is added (the mini-PCIe Renesas card took
# usb1/usb3 and pushed the TI controller to usb4/usb5).  U1/U2 on the modem's
# port is what caused the SuperSpeed reset storm.
DEV=$(basename "$P")                      # e.g. 3-1 or 3-1.2
BUS=${DEV%%-*}; PORT=${DEV#*-}; PORT=${PORT%%.*}
LPM="/sys/bus/usb/devices/usb$BUS/$BUS-0:1.0/usb$BUS-port$PORT/usb3_lpm_permit"
if [ -w "$LPM" ] && [ "$(cat "$LPM")" != "0" ]; then
	echo 0 > "$LPM" && echo "usb3 lpm refused on usb$BUS port $PORT (modem's port)"
fi

CUR=$(uci -q get network.wwan.device)
[ "$CUR" = "$P" ] && { echo "unchanged: $P"; exit 0; }
uci set network.wwan.device="$P"
uci commit network
echo "network.wwan.device: ${CUR:-unset} -> $P"
ifup wwan
