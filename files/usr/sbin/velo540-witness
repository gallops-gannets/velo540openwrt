#!/bin/sh
# VeloCloud Edge 5x0 OOB witness: ping a list of targets, log state changes,
# page via Pushover or ntfy when configured, and light the red logo LED while
# anything is down.  Config in /etc/config/velo540:
#   config witness
#       option period '30'                 # seconds between rounds
#       option fails  '3'                  # consecutive misses before "down"
#       option pushover_token ''  option pushover_user ''
#       option ntfy_url ''                 # e.g. https://ntfy.sh/mytopic
#       list target 'router=192.168.9.1'
#       list target 'internet=1.1.1.1'
u() { v=$(uci -q get velo540.@witness[0].$1); echo "${v:-$2}"; }
period=$(u period 30); fails=$(u fails 3)
pt=$(u pushover_token ""); pu=$(u pushover_user ""); ntfy=$(u ntfy_url "")
targets=$(uci -q get velo540.@witness[0].target)
[ -n "$targets" ] || { logger -t velo540-witness "no targets configured"; exit 0; }
LED=/sys/class/leds/pca963x:red:logo/brightness
page() {	# $1 = title, $2 = message
	logger -t velo540-witness "$1: $2"
	[ -n "$pt" ] && [ -n "$pu" ] && curl -s -m 10 -F "token=$pt" -F "user=$pu" -F "title=$1" -F "message=$2" https://api.pushover.net/1/messages.json >/dev/null 2>&1
	[ -n "$ntfy" ] && curl -s -m 10 -H "Title: $1" -d "$2" "$ntfy" >/dev/null 2>&1
	return 0
}
state_dir=/tmp/velo540-witness; mkdir -p $state_dir
logger -t velo540-witness "watching: $(echo $targets | tr ' ' ',')"
while :; do
	down_any=0
	for t in $targets; do
		name=${t%%=*}; ip=${t##*=}; f=$state_dir/$name
		miss=$(cat $f.miss 2>/dev/null || echo 0); st=$(cat $f.state 2>/dev/null || echo up)
		if ping -c1 -W3 "$ip" >/dev/null 2>&1; then
			miss=0
			[ "$st" = down ] && { page "velo witness: $name recovered" "$name ($ip) is answering again after $(( $(date +%s) - $(cat $f.since) ))s"; st=up; }
		else
			miss=$(( miss + 1 ))
			if [ "$st" = up ] && [ $miss -ge $fails ]; then st=down; date +%s > $f.since; page "velo witness: $name DOWN" "$name ($ip) missed $miss pings"; fi
		fi
		[ "$st" = down ] && down_any=1
		echo $miss > $f.miss; echo $st > $f.state
	done
	[ -w "$LED" ] && echo $down_any > "$LED"
	sleep "$period"
done
