#!/bin/sh
# VeloCloud Edge 5x0 fan control: software closed loop on the EMC2104 tach.
#
# The fan is a 4-pin PWM unit.  With PCA9557@0x1c pin 6 (FORCE_PWM) low and
# pin 7 (FORCE_12V) high the chip's 26 kHz PWM reaches the fan's PWM pin and
# its tach is readable (in the vendor's both-high state the tach reads
# 0xfff8, which made the vendor RPM table spin-up every 15 s).  The chip's
# own RPM algorithm did not converge on this fan, so the loop is here: each
# period the duty moves one step toward the temperature-derived target RPM;
# a tach of 0 with duty > 0 is a stall and gets a spin-up kick.  The stock
# fan runs 2700-4000 RPM (stalls below ~2700; one duty step = ~200 RPM down
# there), hence min_rpm 2950, a duty floor of 10 and a +/-150 RPM dead band.
# Tunables in /etc/config/velo540:
#   config fan
#       option min_rpm '2950'   # target at or below t_min C (stock fan: one duty step above stall)
#       option max_rpm '3900'   # target at or above t_max C
#       option t_min   '50'
#       option t_max   '75'
#       option period  '3'
BUS=9; ADDR=0x2f
u() { v=$(uci -q get velo540.@fan[0].$1); echo "${v:-$2}"; }
min_rpm=$(u min_rpm 2950); max_rpm=$(u max_rpm 3900); tmin=$(u t_min 50); tmax=$(u t_max 75); period=$(u period 3)
E() { i2cset -y $BUS $ADDR "$1" "$2"; }
G() { i2cget -y $BUS $ADDR "$1" 2>/dev/null; }

[ "$(G 0xfd)" = "0x1d" ] || { logger -t velo540-fand "no EMC2104 at $ADDR"; exit 1; }
b2=""; for c in /sys/class/gpio/gpiochip*; do [ "$(cat $c/label 2>/dev/null)" = "9-001c" ] && b2=${c#*gpiochip}; done
if [ -n "$b2" ]; then
	for p in 6 7; do g=$(( b2 + p )); [ -d /sys/class/gpio/gpio$g ] || echo $g > /sys/class/gpio/export; echo out > /sys/class/gpio/gpio$g/direction; done
	echo 0 > /sys/class/gpio/gpio$(( b2 + 6 ))/value	# FORCE_PWM low
	echo 1 > /sys/class/gpio/gpio$(( b2 + 7 ))/value	# FORCE_12V high
fi
E 0x50 0x00	# lookup table off
E 0x2b 0x0c	# PWM base 26 kHz
E 0x41 0x01	# divider 1
E 0x42 0x10	# open-loop PWM: the loop below owns the drive

read_rpm() {
	t=$(( $(printf %d "$(G 0x4e)") * 256 + $(printf %d "$(G 0x4f)") ))
	[ $t -ge 65528 ] && echo 0 || echo $(( 3932160 / (t >> 3) ))
}
duty=$(printf %d "$(G 0x40)"); [ "$duty" -lt 10 ] && duty=12
E 0x40 $duty
n=0
while :; do
	temp=0
	for r in 0x00 0x02 0x04; do
		v=$(printf %d "$(G $r)" 2>/dev/null) || continue
		[ "$v" -gt 127 ] && continue
		[ "$v" -gt "$temp" ] && temp=$v
	done
	if [ "$temp" -le "$tmin" ]; then target=$min_rpm
	elif [ "$temp" -ge "$tmax" ]; then target=$max_rpm
	else target=$(( min_rpm + (max_rpm - min_rpm) * (temp - tmin) / (tmax - tmin) )); fi
	rpm=$(read_rpm)
	if [ "$rpm" -eq 0 ]; then			# stalled: kick, then resume above the stall point
		E 0x40 0x60; sleep 2; duty=14; E 0x40 $duty; logger -t velo540-fand "stall detected, kicked"
	else
		err=$(( rpm - target )); step=$(( (err < 0 ? -err : err) / 150 )); [ $step -lt 1 ] && step=1; [ $step -gt 8 ] && step=8
		if [ "$err" -lt -150 ] && [ "$duty" -lt 255 ]; then duty=$(( duty + step )); [ $duty -gt 255 ] && duty=255; E 0x40 $duty
		elif [ "$err" -gt 150 ] && [ "$duty" -gt 10 ]; then duty=$(( duty - step )); [ $duty -lt 10 ] && duty=10; E 0x40 $duty
		fi
	fi
	n=$(( n + 1 ))
	[ $(( n % 20 )) -eq 1 ] && logger -t velo540-fand "temp ${temp}C target ${target} rpm ${rpm} duty ${duty}"
	sleep "$period"
done
