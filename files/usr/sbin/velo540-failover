#!/bin/sh
# Primary/cellular failover without mwan3: the router port (wan) holds the
# default route at a low metric, cellular (wwan) at metric 100.  Every
# `period` s probe two targets THROUGH the primary (host routes pin them to
# it); after `fails` misses withdraw the primary default so wwan's route
# carries everything; when the probes answer again, put it back.
# mwan3 is deliberately not used: it flushes Tailscale's route table (52)
# on every restart/stop and cut off remote access twice (2026-09-15).
# Interface names wan/wwan also drive the blue-LED/WiFi hook.
period=$(uci -q get velo540.@cell[0].probe_period); period=${period:-10}
fails=$(uci -q get velo540.@cell[0].probe_fails); fails=${fails:-3}
. /lib/functions/network.sh
STATE=/tmp/velo540-failover.state
probes="1.1.1.1 8.8.8.8"
miss=0; state=primary; saved=; echo primary > $STATE
# House-wide failover is the ROUTER's decision (router-failover withdraws its
# fibre default and installs a route to us on GE2/uplink2).  This box's own
# probes keep answering through that very path, so its own state never flips.
# Since 2026-09-20 the router TELLS us the house state: GET /cgi-bin/house
# (token-guarded, GE2 only) writes $SIGNAL on every transition and as a
# heartbeat about once a minute.  The earlier byte-count heuristic on GE2 is
# gone -- it paged "house on cellular" for three Macs' encrypted DNS leaking
# through a pinned probe route, with the router firmly on fibre.
# While the house is on cellular: cake-autorate runs (its reflector pings then
# follow the cellular path and cost ~6 MB/h only while there is load) and the
# logo LED is blue.
# While the house is on fibre: the LEAK DETECTOR runs.  Any conntrack flow
# from the router's GE2 address (10.11.1.2) that is not one of the router's
# own velo-path probes and not addressed to this box is house traffic that
# reached our cellular NAT without a failover -- exactly what must never
# happen -- and it pages, with the flow, via the witness's channels.
HOUSE=/tmp/velo540-house.state; house=primary; echo primary > $HOUSE
SIGNAL=/tmp/velo540-house.signal; AGE=/tmp/velo540-house.age
LEAK=/tmp/velo540-leak.state; LEAKS=/tmp/velo540-leak.sample
house_allow=$(uci -q get velo540.@cell[0].house_allow); house_allow=${house_allow:-"208.67.222.222 76.76.2.0"}  # router-failover's vprobes
leak_grace=$(uci -q get velo540.@cell[0].leak_grace); leak_grace=${leak_grace:-180}   # s after a failover ends before flows count (TIME_WAIT is 120)
leak_repage=$(uci -q get velo540.@cell[0].leak_repage); leak_repage=${leak_repage:-3600}
house_since=$(date +%s); leak_hits=0; leak_paged=0; rm -f $LEAK $LEAKS
u() { v=$(uci -q get velo540.@witness[0].$1); echo "${v:-$2}"; }
pt=$(u pushover_token ""); pu=$(u pushover_user ""); ntfy=$(u ntfy_url "")
page() {	# $1 = title, $2 = message (same channels as velo540-witness)
	logger -t velo540-failover "$1: $2"
	[ -n "$pt" ] && [ -n "$pu" ] && curl -s -m 10 -F "token=$pt" -F "user=$pu" -F "title=$1" -F "message=$2" https://api.pushover.net/1/messages.json >/dev/null 2>&1
	[ -n "$ntfy" ] && curl -s -m 10 -H "Title: $1" -d "$2" "$ntfy" >/dev/null 2>&1
	return 0
}
leak_check() {
	local pat t n sample now
	pat="dst=10.11.1.1 "; for t in $house_allow; do pat="$pat|dst=$t "; done
	sample=$(grep "src=10.11.1.2 " /proc/net/nf_conntrack 2>/dev/null | grep -vE "$pat" \
		| awk '{d="";p="";for(i=1;i<=NF;i++){if($i~/^dst=/&&d=="")d=substr($i,5);if($i~/^dport=/&&p=="")p=substr($i,7)} print $3"/"d":"p}' \
		| sort | uniq -c | sort -rn | head -5 | awk '{printf "%s x%d; ", $2, $1}')
	n=$(grep "src=10.11.1.2 " /proc/net/nf_conntrack 2>/dev/null | grep -vcE "$pat")
	now=$(date +%s)
	if [ "${n:-0}" -gt 0 ]; then
		leak_hits=$(( leak_hits + 1 ))
		[ $leak_hits -ge 2 ] || return		# two consecutive periods, not one stray entry
		echo $n > $LEAK; echo "$sample" > $LEAKS
		if [ $leak_paged -eq 0 ] || [ $(( now - leak_paged )) -ge $leak_repage ]; then
			page "CELLULAR LEAK: house traffic on 5G while the router says fibre" "$n flow(s) from the house reached the modem with no failover declared: ${sample}Something on the router routes past the tracker."
			leak_paged=$now
		fi
	else
		leak_hits=0
		if [ -e $LEAK ]; then rm -f $LEAK $LEAKS; leak_paged=0; logger -t velo540-failover "cellular leak cleared: no house flows on the modem"; fi
	fi
}
house_check() {
	local sig now age
	now=$(date +%s)
	sig=$(cat $SIGNAL 2>/dev/null); sig=${sig:-primary}
	if [ -e $SIGNAL ]; then age=$(( now - $(date -r $SIGNAL +%s) )); else age=-1; fi	# busybox here has no stat
	echo $age > $AGE
	if [ "$sig" != "$house" ]; then
		house=$sig; echo $house > $HOUSE; house_since=$now
		if [ $house = cellular ]; then
			logger -t velo540-failover "router says the house is on cellular: starting cake-autorate"
			[ -x /etc/init.d/cake-autorate ] && /etc/init.d/cake-autorate start >/dev/null 2>&1
		else
			logger -t velo540-failover "router says the house is back on fibre: stopping cake-autorate"
			[ -x /etc/init.d/cake-autorate ] && /etc/init.d/cake-autorate stop >/dev/null 2>&1
		fi
		/etc/hotplug.d/iface/90-velo540-led >/dev/null 2>&1
	fi
	[ $house = primary ] && [ $(( now - house_since )) -ge $leak_grace ] && leak_check
}
while :; do
	house_check
	network_get_gateway gw wan; network_get_device dev wan
	if [ -z "$gw" ] || [ -z "$dev" ]; then sleep $period; continue; fi
	for t in $probes; do ip route replace $t via $gw dev $dev metric 5 2>/dev/null; done
	ok=0; for t in $probes; do ping -I $dev -c1 -W3 $t >/dev/null 2>&1 && { ok=1; break; }; done
	if [ $ok -eq 1 ]; then
		miss=0
		if [ $state = failover ]; then
			if [ -n "$saved" ]; then ip route replace $saved; else ip route replace default via $gw dev $dev metric 10; fi; state=primary; echo primary > $STATE
			logger -t velo540-failover "primary WAN answers again: default route restored"
			/etc/hotplug.d/iface/90-velo540-led >/dev/null 2>&1
		fi
	else
		miss=$(( miss + 1 ))
		# a DHCP renewal on wan re-adds its default route behind our back
		[ $state = failover ] && ip route del default via $gw dev $dev 2>/dev/null
		if [ $state = primary ] && [ $miss -ge $fails ]; then
			saved=$(ip route show default dev $dev | head -1); ip route del default via $gw dev $dev 2>/dev/null; state=failover; echo failover > $STATE
			logger -t velo540-failover "primary WAN dead ($miss misses): default withdrawn, cellular carries traffic"
			/etc/hotplug.d/iface/90-velo540-led >/dev/null 2>&1
		fi
	fi
	sleep $period
done
