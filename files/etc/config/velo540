# Per-unit settings, preserved across sysupgrade.
# memmap: RAM pages to keep out of use (see /etc/init.d/velo540-memmap), e.g.
#   list reserve '4K$0x21bb4a000'
config memmap

# fan: closed-loop RPM targets, see /usr/sbin/velo540-fand
config fan
	option min_rpm '3400'
	option max_rpm '3900'
	option t_min '50'
	option t_max '75'
	option off_below '0'
	option on_above '0'
	option tach 'auto'
	option min_duty '40'

# dsa: 0 = two dumb switches (eth0/eth1), 3 = DSA for both (lan1..lan8); see velo540-dsa
config dsa
	option mask '0'

# witness: reachability probes + paging (see velo540-witness); fill in a token to page
config witness
	option period '30'
	option fails '3'
	option pushover_token ''
	option pushover_user ''
	option ntfy_url ''
	list target 'internet=1.1.1.1'

# cell: cellular failover (velo540-cell); bands for the optional band lock
config cell
	option locked '0'
	option ss_lpm_off '3-0:1.0/usb3-port1'   # refuse USB3 U1/U2 so the modem runs at 5 Gbps (see velo540-switch)
	# option ss_disable '3-0:1.0/usb3-port1'  # fallback: force the modem onto USB2 instead

# pdu: the iBoot PDU8A-N15 on the OOB LAN (velo540-pdu).  Password lives in
# /etc/velo540-pdu.secret (mode 600; keep it listed in /etc/sysupgrade.conf).
config pdu
	option host '10.11.0.10'
	# list outlet 'router=1'    # name=number, one per outlet you want to address by name
	# list outlet 'ont=2'
