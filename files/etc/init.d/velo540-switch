#!/bin/sh /etc/rc.common
# VeloCloud Edge 520/540: bring the two 88E6176 switches up as plain
# 4-port switches behind eth0 (switch A) and eth1 (switch B).
# Register sequence taken from the vendor igb_vc.c and verified live:
#  - port 4 SerDes: autoneg off, power up, reset (SMI device 0xf, page 1)
#  - port 4: clear PHYDetect, force MAC 1000/full
#  - internal PHYs 0-3: clear power-down, reset
#  - ports 0-4 -> Forwarding, ports 5/6 (RGMII cross-links) stay Disabled
# Needs mdio-tools + kmod-mdio-netlink and the igb-vc-* buses from the
# patched igb.
START=19

R() { mdio "$B" phy "$1" raw "$2"; }
W() { mdio "$B" phy "$1" raw "$2" "$3"; }
smiw() { W 0x1c 0x19 "$3"; W 0x1c 0x18 $(( 0x9400 | ($1 << 5) | $2 )); }
smir() { W 0x1c 0x18 $(( 0x9800 | ($1 << 5) | $2 )); R 0x1c 0x19; }

switch_up() {
	B="$1"
	id=$(R 0x10 3 2>/dev/null) || return 1
	case "$id" in 0x176*) ;; *) echo "$B: no 88E6176 ($id)"; return 1;; esac

	smiw 0xf 22 1
	v=$(smir 0xf 0)
	smiw 0xf 0 $(( (v | 0x8100) & ~0x1800 ))
	sleep 1
	st=$(R 0x14 0)
	W 0x14 0 $(( st & ~0x1000 ))
	W 0x14 1 0x000e

	for d in 0 1 2 3; do
		smiw $d 22 0
		smiw $d 0 0x9140
	done

	for p in 0 1 2 3 4; do
		a=$(( 0x10 + p )); c=$(R $a 4)
		W $a 4 $(( (c & ~3) | 3 ))
	done
	for p in 5 6; do
		a=$(( 0x10 + p )); c=$(R $a 4)
		W $a 4 $(( c & ~3 ))
	done
	echo "$B: 88E6176 $id up, port4 status $(R 0x14 0)"
}

# WAN RJ45 (ge1/ge2): two 88E1514 PHYs on the bit-bang bus gpio-0, held in
# reset by PCA9557@0x18 pin 4 (input at power-on).  Instantiate the expander
# on the i2c-gpio adapter the glue registers, pulse the reset, then re-probe
# the two igb functions that deferred/failed at boot.
wan_up() {
	[ -d /sys/bus/i2c/devices/i2c-9 ] || { echo "i2c-9 (i2c-gpio) missing"; return 1; }
	[ -d /sys/bus/i2c/devices/9-0018 ] || echo pca9557 0x18 > /sys/bus/i2c/devices/i2c-9/new_device
	sleep 1
	base=""
	for c in /sys/class/gpio/gpiochip*; do
		[ "$(cat $c/label 2>/dev/null)" = "9-0018" ] && base=${c#*gpiochip}
	done
	[ -n "$base" ] || { echo "pca9557 gpiochip missing"; return 1; }
	g=$(( base + 4 ))
	[ -d /sys/class/gpio/gpio$g ] || echo $g > /sys/class/gpio/export
	echo out > /sys/class/gpio/gpio$g/direction
	echo 0 > /sys/class/gpio/gpio$g/value
	sleep 1
	echo 1 > /sys/class/gpio/gpio$g/value
	sleep 1
	for f in 0000:00:14.2 0000:00:14.3; do
		[ -e /sys/bus/pci/drivers/igb/$f ] || echo $f > /sys/bus/pci/drivers/igb/bind 2>/dev/null
	done
	# LED wiring on this board (vendor igb_vc_setup_m88e1514): page 3,
	# LED[0] = gigabit link, LED[1] = 10/100 link + activity.  The PHY
	# default leaves both solid on.  Survives the PHY soft reset igb does.
	for a in 0 1; do
		mdio gpio-0 phy $a raw 22 3
		mdio gpio-0 phy $a raw 16 0x0817
		mdio gpio-0 phy $a raw 17 0x0005
		mdio gpio-0 phy $a raw 22 0
	done
	echo "wan PHY reset done, gpio-0: $(mdio gpio-0 phy 0 raw 2) $(mdio gpio-0 phy 1 raw 2)"
}

# Fan: Microchip EMC2104 at 0x2f on the same bus, PWM 100% at power-on.
# Vendor programming (velocloud-vc.c vc_5x0_probe_fan): PWM divider, an
# 8-row RPM lookup table (tach target vs. temp; below 50C the fan stops,
# 2132 RPM at 50C .. 5506 RPM at 71C), closed-loop mode, 2C hysteresis,
# then lock/enable the table.  Product ID reg 0xfd must read 0x1d.
fan_up() {
	[ -d /sys/bus/i2c/devices/i2c-9 ] || return 1
	[ "$(i2cget -y 9 0x2f 0xfd 2>/dev/null)" = "0x1d" ] || { echo "no EMC2104 at 0x2f"; return 1; }
	E() { i2cset -y 9 0x2f "$1" "$2"; }
	E 0x41 0x80
	E 0x50 0x00
	i=0x51
	for b in 0x56 0x32 0x32 0x32 0xff  0x46 0x35 0x35 0x35 0xff \
		 0x3b 0x38 0x38 0x38 0xff  0x33 0x3b 0x3b 0x3b 0xff \
		 0x2d 0x3e 0x3e 0x3e 0xff  0x28 0x41 0x41 0x41 0xff \
		 0x24 0x44 0x44 0x44 0xff  0x21 0x47 0x47 0x47 0xff; do
		E $i $b; i=$(( i + 1 ))
	done
	E 0x42 0x90
	E 0x79 0x02
	E 0x50 0x20
	# PCA9557@0x1c pins 6 (FORCE_PWM) and 7 (FORCE_12V) must be high for the
	# PWM to take effect; low = fan hard-wired to full speed.  Pins 0/1 are
	# PoE control: never touch them.
	[ -d /sys/bus/i2c/devices/9-001c ] || echo pca9557 0x1c > /sys/bus/i2c/devices/i2c-9/new_device
	sleep 1
	b2=""
	for c in /sys/class/gpio/gpiochip*; do
		[ "$(cat $c/label 2>/dev/null)" = "9-001c" ] && b2=${c#*gpiochip}
	done
	if [ -n "$b2" ]; then
		for p in 6 7; do
			g=$(( b2 + p ))
			[ -d /sys/class/gpio/gpio$g ] || echo $g > /sys/class/gpio/export
			echo out > /sys/class/gpio/gpio$g/direction
			echo 1 > /sys/class/gpio/gpio$g/value
		done
	fi
	echo "fan: EMC2104 lookup table enabled, temps $(i2cget -y 9 0x2f 0)/$(i2cget -y 9 0x2f 2)/$(i2cget -y 9 0x2f 4)/$(i2cget -y 9 0x2f 6) C"
}

start() {
	[ -x /usr/bin/mdio ] || { echo "mdio-tools missing"; return 1; }
	for B in /sys/class/mdio_bus/igb-vc-*; do
		[ -e "$B" ] || continue
		switch_up "$(basename "$B")"
	done
	wan_up
	fan_up
}
