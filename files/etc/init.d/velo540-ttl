#!/bin/sh /etc/rc.common
# Carrier tethering detection works on TTL/hop-limit: traffic the modem's own
# host originates has TTL 64, forwarded traffic arrives with 63 and is tagged
# as "hotspot" and throttled/deprioritised.  Rewrite everything leaving wwan0
# to TTL/HL 65 (the modem decrements once).  Own nft table, so fw4 reloads do
# not touch it (see home-network-ops CLAUDE.md: never in /etc/nftables.d).
START=95
start() {
	nft list table inet velo_ttl >/dev/null 2>&1 && nft delete table inet velo_ttl
	nft add table inet velo_ttl
	nft add chain inet velo_ttl post '{ type filter hook postrouting priority mangle; }'
	# wwan0 when the bearer is plain, qmapmux* when it is multiplexed (QMAP).
	for o in "wwan0" "qmapmux*" "rmnet*"; do
		nft add rule inet velo_ttl post oifname "$o" ip ttl set 65
		nft add rule inet velo_ttl post oifname "$o" ip6 hoplimit set 65
	done
	# Management traffic first on cellular: everything this box itself originates
	# (Tailscale, SSH, witness probes, PDU) leaves marked CS6, which CAKE's
	# diffserv4 puts in the Voice tin above the house's bulk traffic.  Forwarded
	# packets never pass the output hook, so they are untouched.
	nft add chain inet velo_ttl out '{ type filter hook output priority mangle; }'
	for o in "wwan0" "qmapmux*" "rmnet*"; do
		nft add rule inet velo_ttl out oifname "$o" ip dscp set cs6
		nft add rule inet velo_ttl out oifname "$o" ip6 dscp set cs6
	done
}
stop() { nft delete table inet velo_ttl 2>/dev/null; }
