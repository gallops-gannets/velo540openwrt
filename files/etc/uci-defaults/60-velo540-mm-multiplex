#!/bin/sh
# Teach netifd's modemmanager proto to use a multiplexed (QMAP) bearer.
#
# Two things are missing upstream:
#   1. there is no "multiplex" option, and netifd drops options a proto has not
#      declared, so it never reaches mmcli;
#   2. ModemManager names the rmnet mux link "qmapmux0.0", and netifd reads the
#      dot as a VLAN tag and refuses the notify_proto call, so the interface
#      never comes up.
#
# Without both, the modem runs unaggregated: ~120 Mbps on this board against
# 170-295 Mbps with them (RM520N-GL, 5G SA n41, USB 3).  Needs kmod-rmnet.
#
# This lives in uci-defaults so it is re-applied after every sysupgrade, since
# the proto ships in the modemmanager package and is overwritten by it.  If
# upstream changes the file enough that the patch does not apply, the proto is
# left alone and the bearer is not multiplexed.
#
# That was meant to be a safe fallback and it is NOT.  THIS PATCH IS LOAD
# BEARING: on the tested box a non-multiplexed bearer never completes.
# Cause found 2026-09-19 with ModemManager debug logging (MM 1.24, RM520N-GL,
# Renesas USB 3 host): the module's firmware default data format is QMAP v5
# aggregation.  For a plain bearer MM switches that to "disabled" (WDA Set Data
# Format), then sends WDS Start Network, and the module never answers it; the
# connect sits in "connecting" until mmcli's 120 s timeout.  With
# multiplex=required MM keeps QMAP v5 and the call completes in ~10 s.  Proven
# three ways: patched proto with multiplex=none, the pristine stock proto with
# no option (MM's default is none), and the same again with the earlier TI host
# controller on 2026-09-16.  So this is the module firmware plus MM, not this
# patch and not the USB path.  Consequence: if the patch fails to apply after a
# sysupgrade, the box loses cellular.  A failure now leaves
# /etc/velo540-mm-multiplex.FAILED and logs at daemon.err so it can be seen.
F=${MM_PROTO:-/lib/netifd/proto/modemmanager.sh}
[ -f "$F" ] || exit 0
FLAG=/etc/velo540-mm-multiplex.FAILED
fail() { logger -p daemon.err -t velo540-mm-multiplex "proto patch did NOT apply ($1): cellular will not connect"; echo "$(date) $1" > $FLAG; rm -f /tmp/.mm-multiplex.$$; exit 0; }
grep -q 'velo540: multiplex' "$F" && { rm -f $FLAG; exit 0; }

awk '
# 1. declare the option next to the other strings
/^[ \t]*proto_config_add_string iptype[ \t]*$/ && !decl {
	print
	print "\tproto_config_add_string multiplex\t# velo540: multiplex"
	decl = 1
	next
}
# 2. read it out of the interface config
/json_get_vars device apn allowedauth username password[ \t]*$/ && !rd {
	sub(/[ \t]*$/, "")
	print $0 " multiplex"
	rd = 1
	next
}
# 3. pass it to mmcli.  This line appears twice; only the second builds the
#    connect arguments, the first is for the initial EPS bearer settings.
/^[ \t]*append_param "\$\{password:\+password=\$\{password\}\}"[ \t]*$/ {
	pw++
	print
	if (pw == 2) print "\tappend_param \"${multiplex:+multiplex=${multiplex}}\""
	next
}
# 4. clear mux links left over from a previous session.  Renaming the link (see
#    below) means ModemManager can no longer delete it on teardown, and a stale
#    link holds its mux id so the next connect fails with "failed to create net
#    link for device".  At this point MM has disconnected, so any survivor is a
#    leak.
/^[ \t]*mmcli --modem="\$\{device\}" --timeout 120 --simple-connect=/ && !clean {
	print "\tfor l in $(ls /sys/class/net 2>/dev/null | grep \"^qmapmux\"); do ip link del \"$l\" 2>/dev/null; done\t# velo540: mux cleanup"
	clean = 1
}
# 5. give the mux link a name netifd will accept
/^[ \t]*bearermethod_ipv4=\$\(modemmanager_get_field/ && !ren {
	print "\tcase \"${beareriface}\" in"
	print "\t*.*)"
	print "\t\tmuxnew=$(echo \"${beareriface}\" | tr -d \".\")"
	print "\t\tip link set \"${beareriface}\" down 2>/dev/null"
	print "\t\tip link set \"${beareriface}\" name \"${muxnew}\" 2>/dev/null && beareriface=\"${muxnew}\""
	print "\t\tip link set \"${beareriface}\" up 2>/dev/null"
	print "\t\t;;"
	print "\tesac"
	ren = 1
}
{ print }
' "$F" > /tmp/.mm-multiplex.$$ || fail awk

# Only adopt the result if every edit landed and the shell still parses it.
for pat in 'proto_config_add_string multiplex' 'password multiplex' 'multiplex=${multiplex}' 'muxnew' 'velo540: mux cleanup'; do
	grep -q "$pat" /tmp/.mm-multiplex.$$ || fail "missing: $pat"
done
sh -n /tmp/.mm-multiplex.$$ 2>/dev/null || fail syntax

cat /tmp/.mm-multiplex.$$ > "$F"
rm -f /tmp/.mm-multiplex.$$
chmod 755 "$F"
rm -f $FLAG
exit 0
