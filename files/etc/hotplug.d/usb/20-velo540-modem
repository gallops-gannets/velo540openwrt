# Re-point network.wwan.device when the modem appears on a different bus.
# It enumerates as usb1/1-1 at USB 2 and usb3/3-1 at SuperSpeed, and netifd
# pins it by sysfs path, so a re-plug onto the other bus otherwise leaves the
# cellular path down with "couldn't find modem".
case "$ACTION" in add) ;; *) exit 0 ;; esac
case "$PRODUCT" in 2c7c/*) ;; *) exit 0 ;; esac
[ -x /usr/sbin/velo540-modemdev ] || exit 0
# Let ModemManager finish probing before netifd is asked to bring it up.
(sleep 10; /usr/sbin/velo540-modemdev -u) >/dev/null 2>&1 &
